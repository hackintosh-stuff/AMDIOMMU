<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.example.round14load</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/Users/ling/r12work/tools/round14-load.sh</string>
		<string>/Users/ling/r14load</string>
		<!-- the TARGET device: RTL8127, MAC 1c:86:0b:3b:0b:bd. -->
		<string>en2</string>
		<!-- the peer is the Windows operator machine, reached over the SAME
		     link that carries en2. Verified end to end before this run: a
		     datagram from 192.168.50.216 (en2) to 192.168.50.122 was echoed
		     and logged by the peer. -->
		<string>192.168.50.122</string>
		<string>9110</string>
		<!-- start 38 s after boot, in MACH seconds (CLOCK_UPTIME_RAW), not
		     wall-clock seconds. The probe's window opens at ~37.8 s mach time
		     and runs ~3 s; four requests spread over ~0.9 s therefore land
		     inside it with margin at both ends. -->
		<string>38</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/ling/r14load/launchd.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/ling/r14load/launchd.err</string>
</dict>
</plist>
