<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.example.round10load</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/Users/ling/r10work/tools/round10-load.sh</string>
		<string>/Users/ling/r10load</string>
		<!-- the TARGET device: RTL8127, MAC 1c:86:0b:3b:0b:bd.
		     Round 9 used en0 here, which is a DIFFERENT NIC, and the
		     report still called the result "the controlled chain". -->
		<string>en2</string>
		<!-- the peer's address ON THE TARGET DEVICE'S SUBNET. The peer
		     host also has 192.168.50.122 on its other port; using that
		     would route through en0 again. -->
		<string>192.168.60.122</string>
		<string>9110</string>
		<!-- unique run token for this run; the driver records it -->
		<string>2749086341</string>
		<!-- a SMALL fixed batch: 4 requests -->
		<string>4</string>
		<!-- start 37 s after boot. MEASURED, not assumed: the probe's
		     window opened at 36.99 s and closed at 40.00 s in the previous
		     run: window open 37.21 s, close 40.21 s, in MACH seconds.
		     The number here is therefore MACH seconds since boot, not wall
		     seconds -- round 10's first attempts used wall seconds and the
		     load landed 6 s after the window closed. The client spreads
		     its 4 requests over ~0.9 s, so 38 puts all of them inside. -->
		<string>38</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/ling/r10load/launchd.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/ling/r10load/launchd.err</string>
</dict>
</plist>
