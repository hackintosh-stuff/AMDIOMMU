<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.example.round8load</string>
    <!--
      WHY A LAUNCH DAEMON
      -------------------
      The probe's measurement window opens about 20 s after boot and lasts 3 s.
      SSH is not reachable until well after that, so a load started from an SSH
      session can never cover the window. This job starts the load at boot so
      the window is covered deterministically.

      It is TEMPORARY and is removed after the capture. It only runs ping/nc to
      the local gateway and a peer; it changes no system state.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/ling/iommu-work/load-round8.sh</string>
        <string>/Users/ling/round8-load.log</string>
        <string>150</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/ling/round8-load.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/ling/round8-load.err</string>
</dict>
</plist>
